# Read by next.config.ts when the dev server starts: where /api/* is proxied.
# Without it there is no proxy and every API call 404s against Next itself.
BACKEND_URL=http://localhost:8000

# Baked into the bundle at build time (the QA and prod images pass it as a
# build arg). It does not route API calls: api-client uses a relative /api/v1
# and rides the rewrite above.
NEXT_PUBLIC_API_URL=http://localhost:8000

NEXT_PUBLIC_BYBIT_USDT_ADDRESS=
