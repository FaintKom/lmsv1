# Refuse to install on the wrong npm instead of writing a lock file that CI
# cannot read. Without this, `engines` in package.json is only a warning, and
# the warning is what got ignored: npm 11 wrote a lock that the npm 10 in CI
# rejected outright, so `npm ci` failed before lint, typecheck or build ran.
#
# If npm stops here with EBADENGINE, it is doing its job. Use node 22
# (`nvm use`, which reads ../.nvmrc), or `npx npm@10` for a one-off.
engine-strict=true
