# Per-worktree QA stack: copy to .env.qa.local and change the numbers.
#
# Without this file everything behaves as it always has — the compose file keeps
# the old project name and the old ports as defaults, so CI and a single chat need
# no setup at all.
#
# With it, a second chat can hold its own stack instead of recreating the first
# chat's containers. That is not a nicety. On 2026-08-19 one session rebuilt the
# shared stack mid-run: the other lost its seeded data and its session, and the
# scripts mounted into the containers came from the *other* checkout, so a script
# "run here" was somebody else's file.
#
#     cp .env.qa.local.example .env.qa.local     # then edit
#     docker compose --env-file .env.qa.local -f docker-compose.qa.yml up -d --build --wait
#
# Pass --env-file on every compose command for this stack, `down` included.

# Container names and the compose project. Anything but the default.
QA_PROJECT=lms-qa-second

# Host ports. Pick a lane and keep it: the frontend bakes the backend URL in at
# build time, so changing QA_BACKEND_PORT means rebuilding the frontend image, not
# just restarting it.
QA_BACKEND_PORT=8010
QA_FRONTEND_PORT=3010
QA_SANDBOX_PORT=8111

# Media. Only needed when the live-lesson journeys run here.
QA_LIVEKIT_PORT=7890
QA_LIVEKIT_TCP_PORT=7891
QA_LIVEKIT_UDP_RANGE=7892-7893

# Postgres for pytest is not a compose port and is not covered by any of the above.
# Give each worktree its own database rather than sharing rows:
#     DATABASE_URL=postgresql+asyncpg://lms:<password>@localhost:5432/lms_test_second
