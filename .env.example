# === GrassLMS — Production Environment ===
# Copy this to .env and fill in values, or use deploy.bat to auto-generate

# Environment: development | staging | production
# In production the server refuses to start if JWT_SECRET is default or DEBUG=true.
ENVIRONMENT=development

# Database
POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://lms:CHANGE_ME_RANDOM_PASSWORD@db:5432/lms

# JWT Authentication
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=CHANGE_ME_RANDOM_64_CHAR_HEX
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Super admin bootstrap (optional, used only on first startup to create the first admin).
# If either is empty, no super admin is created — existing admins are untouched.
# Leave empty after the first admin exists; rotate password via the app, not env.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Where "new waitlist signup" notifications go. Empty = no notifications.
# Needs SMTP configured (EMAIL_ENABLED=true), otherwise sends are logged
# and dropped.
WAITLIST_NOTIFY_EMAIL=

# CORS (comma-separated origins, updated by deploy.bat after tunnel starts)
CORS_ORIGINS=http://localhost:3000

# Sandbox
SANDBOX_URL=http://sandbox:8001

# Stripe (optional, leave empty for demo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry error tracking (optional, empty DSN disables Sentry)
# Backend:
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Frontend (browser needs NEXT_PUBLIC_ prefix; separate DSN recommended):
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Demo mode — exposes POST /auth/demo-login and unlocks the /demo landing page.
# Flip to true ONLY after seeding the demo org once:
#     docker compose -f docker-compose.prod.yml exec backend \
#         python scripts/seed_demo_org.py
# Otherwise the endpoint returns 400 ("Demo account is not available").
DEMO_MODE_ENABLED=false
DEMO_STUDENT_EMAIL=demo-student@grasslms.online
DEMO_TEACHER_EMAIL=demo-teacher@grasslms.online

# App
APP_NAME=GrassLMS
DEBUG=false

# === Optional integrations (leave empty to disable) ===

# Knowledge module (RAG): Voyage AI embeddings. Without this, semantic search
# in the knowledge module is unavailable. Read from the environment directly.
VOYAGE_API_KEY=

# Rate-limiter storage. Default memory:// does NOT work across multiple workers
# (each worker keeps its own counters). In production set this to the Redis URL.
RATE_LIMIT_STORAGE_URI=
REDIS_URL=

# Email / SMTP (Brevo in prod). EMAIL_ENABLED=false disables all sends.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@grasslms.online
EMAIL_FROM_NAME=GrassLMS

# Lesson Q&A assistant. Any OpenAI-compatible chat-completions endpoint.
# Leave LLM_API_KEY empty to keep the feature off: the app starts normally and
# /api/v1/tutor answers 503, so nothing breaks when it is not configured.
# LLM_BASE_URL defaults to OpenRouter; point it at a local Ollama or vLLM to
# run without paying anyone.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=
LLM_API_KEY=

# Live-lesson audio and video (LiveKit, self-hosted beside the LMS).
#
# One key pair serves two things: the media container reads it as LIVEKIT_KEYS,
# and the backend signs each participant's grant with it. They must match or
# every join is refused. Generate any pair you like, but the secret must be at
# least 32 characters — the media server logs an error and rejects anything
# shorter.
#
# MAX_CONCURRENT_MEDIA_PARTICIPANTS is 0 on purpose. Zero means media is off,
# and the real number comes from driving bot load at this host and watching both
# the media container's processor cap and everyone else's page loads. Guessing
# it turns one busy lesson into three slow ones.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=ws://livekit:7880

# The address a *browser* dials, and empty is the right answer for this
# deployment: the page then uses its own origin and nginx proxies /rtc to the
# media server, so media rides the certificate the platform already has.
#
# If a deployment does set it, it must be an origin — `wss://media.example.com`
# — and must **not** end in `/rtc`. The SDK appends that itself. Naming it here
# once meant every browser asked for `/rtc/rtc`, which the media server answers
# `404`; the room never connected in production and the failure looked like a
# camera nobody had switched on.
LIVEKIT_PUBLIC_URL=
MAX_CONCURRENT_MEDIA_PARTICIPANTS=0

# The largest lesson recording the server will take, in megabytes. nginx holds
# a matching limit (`location /api/v1/recordings/`); raise both or neither,
# because whichever is tighter decides, and if that is nginx the teacher gets
# a bare 413 from the proxy instead of the server's explanation.
MAX_RECORDING_UPLOAD_MB=300

# Object storage for uploads. local = on-disk; s3 = S3/R2-compatible bucket.
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL_BASE=
